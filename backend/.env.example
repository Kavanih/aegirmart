# OpenRouter key. Server side only. Never prefix for client exposure.
OPENROUTER_API_KEY=

PORT=8787
SOMNIA_GRAPHQL=https://dev.smk.somnia.host/v1/graphql
# Live testnet venue. The value in the DreamDEX docs points at a dead venue.
VENUE_ID=0x1a1e6821cde7d0159c0d293177871e09677b4e42307c7db3ba94f8648a5a050f

# Set false to stop the tracker spending the daily model allowance.
TRACKER_ENABLED=true

# 32+ chars, required before a bot key can be stored. Never commit the real one.
KEY_ENCRYPTION_SECRET=

# true lets bots trade with their stored keys. Off by default.
RUNNER_ENABLED=false

# Where subscription payments must land.
TREASURY_ADDRESS=0x803f09058F436b760ea241923De14dcE51Fb53ea
